# Copy this file to .env.local and add your Groq API key.
# Get one at https://console.groq.com/keys
# The key is read ONLY on the server (API route); it is never exposed to the browser.
# Without this variable the app still runs in deterministic demo mode.
GROQ_API_KEY=your_groq_api_key_here

# Optional: LLM request timeout in milliseconds (default 30000)
# GROQ_TIMEOUT_MS=30000
